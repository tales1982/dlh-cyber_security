<!--
    MedDefense Health Systems - Windows Fortress (2x01), Task 9 deliverable.
    Baseline Sysmon configuration, inspired by the SwiftOnSecurity reference
    config's philosophy (log what an analyst needs, exclude high-volume
    known-noise), scoped to what 9-sysmon_deploy.ps1 installs and
    3-telemetry_reference.ps1 documents (Event IDs 1, 3, 7, 11, 13, 22 are
    the ones this project's detection work depends on most).
    10-sysmon_tune.ps1 appends 5 MedDefense-specific detection rules to this
    same file (Rclone, PsExec service install, encoded PowerShell, shadow
    copy deletion, scheduled task persistence) - see the "MedDefense Custom
    Detections" rule group at the bottom.
-->
<Sysmon schemaversion="4.90">
  <HashAlgorithms>SHA256</HashAlgorithms>
  <CheckRevocation/>
  <EventFiltering>

    <RuleGroup name="Process Creation" groupRelation="or">
      <ProcessCreate onmatch="exclude">
        <Image condition="end with">svchost.exe</Image>
        <Image condition="end with">MsMpEng.exe</Image>
        <Image condition="end with">SearchIndexer.exe</Image>
      </ProcessCreate>
    </RuleGroup>

    <RuleGroup name="File Create Time" groupRelation="or">
      <FileCreateTime onmatch="exclude">
        <Image condition="end with">chrome.exe</Image>
      </FileCreateTime>
    </RuleGroup>

    <RuleGroup name="Network Connect" groupRelation="or">
      <NetworkConnect onmatch="include">
        <Image condition="is">C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe</Image>
        <Image condition="end with">psexec.exe</Image>
        <Image condition="end with">rclone.exe</Image>
        <DestinationPort condition="is">445</DestinationPort>
        <DestinationPort condition="is">3389</DestinationPort>
        <DestinationPort condition="is">4444</DestinationPort>
      </NetworkConnect>
    </RuleGroup>

    <RuleGroup name="Process Terminate" groupRelation="or">
      <ProcessTerminate onmatch="exclude">
        <Image condition="end with">svchost.exe</Image>
      </ProcessTerminate>
    </RuleGroup>

    <RuleGroup name="Driver Load" groupRelation="or">
      <DriverLoad onmatch="exclude">
        <Signature condition="contains">Microsoft Windows</Signature>
      </DriverLoad>
    </RuleGroup>

    <RuleGroup name="Image Load" groupRelation="or">
      <ImageLoad onmatch="include">
        <ImageLoaded condition="contains">amsi.dll</ImageLoaded>
        <Signed condition="is">false</Signed>
      </ImageLoad>
    </RuleGroup>

    <RuleGroup name="Create Remote Thread" groupRelation="or">
      <CreateRemoteThread onmatch="include">
        <TargetImage condition="end with">lsass.exe</TargetImage>
        <TargetImage condition="end with">winlogon.exe</TargetImage>
      </CreateRemoteThread>
    </RuleGroup>

    <RuleGroup name="Raw Access Read" groupRelation="or">
      <RawAccessRead onmatch="include">
        <Image condition="contains">\</Image>
      </RawAccessRead>
    </RuleGroup>

    <RuleGroup name="Process Access" groupRelation="or">
      <ProcessAccess onmatch="include">
        <TargetImage condition="end with">lsass.exe</TargetImage>
      </ProcessAccess>
    </RuleGroup>

    <RuleGroup name="File Create" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename condition="contains">\Start Menu\Programs\Startup\</TargetFilename>
        <TargetFilename condition="end with">.exe</TargetFilename>
        <TargetFilename condition="end with">.ps1</TargetFilename>
        <TargetFilename condition="end with">.dll</TargetFilename>
      </FileCreate>
    </RuleGroup>

    <RuleGroup name="Registry Event" groupRelation="or">
      <RegistryEvent onmatch="include">
        <TargetObject condition="contains">\CurrentVersion\Run</TargetObject>
        <TargetObject condition="contains">\CurrentVersion\RunOnce</TargetObject>
        <TargetObject condition="contains">\Services\</TargetObject>
      </RegistryEvent>
    </RuleGroup>

    <RuleGroup name="File Create Stream Hash" groupRelation="or">
      <FileCreateStreamHash onmatch="include">
        <TargetFilename condition="contains">\Downloads\</TargetFilename>
      </FileCreateStreamHash>
    </RuleGroup>

    <RuleGroup name="Pipe Event" groupRelation="or">
      <PipeEvent onmatch="include">
        <PipeName condition="contains">\PSHost</PipeName>
        <PipeName condition="contains">\psexec</PipeName>
      </PipeEvent>
    </RuleGroup>

    <RuleGroup name="Wmi Event" groupRelation="or">
      <WmiEvent onmatch="include">
        <Operation condition="is">Created</Operation>
      </WmiEvent>
    </RuleGroup>

    <RuleGroup name="Dns Query" groupRelation="or">
      <DnsQuery onmatch="exclude">
        <QueryName condition="end with">.microsoft.com</QueryName>
        <QueryName condition="end with">.windowsupdate.com</QueryName>
        <Image condition="end with">chrome.exe</Image>
        <Image condition="end with">msedge.exe</Image>
      </DnsQuery>
    </RuleGroup>

    <RuleGroup name="File Delete" groupRelation="or">
      <FileDelete onmatch="include">
        <TargetFilename condition="end with">.ps1</TargetFilename>
        <TargetFilename condition="end with">.exe</TargetFilename>
      </FileDelete>
    </RuleGroup>

  </EventFiltering>
</Sysmon>
