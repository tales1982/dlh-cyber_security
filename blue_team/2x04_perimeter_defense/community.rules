# community.rules
#
# MedDefense Health Systems - Perimeter and Network Defense (2x04)
#
# Baseline community-style detection ruleset used as the "authoritative"
# feed for T8-T9. Written to mirror the shape and sid range of a real
# Emerging Threats Open ruleset (1000000-1999999 = local/custom range per
# the Suricata sid-allocation convention) since this lab has no live
# Internet access to pull the real ET feed. MedDefense-specific rules live
# separately in meddefense.rules (T10, sid 9000000+).

# --- Reconnaissance -----------------------------------------------------
alert tcp any any -> $HOME_NET any (msg:"ET SCAN Rapid TCP SYN Scan Multiple Ports"; flags:S; threshold:type both, track by_src, count 15, seconds 5; classtype:attempted-recon; sid:1000001; rev:1;)
alert icmp any any -> $HOME_NET any (msg:"ET SCAN ICMP Ping Sweep"; itype:8; threshold:type both, track by_src, count 5, seconds 5; classtype:network-scan; sid:1000002; rev:1;)
alert tcp any any -> $HOME_NET 22 (msg:"ET SCAN SSH Brute Force Login Attempt"; flags:S; threshold:type both, track by_src, count 10, seconds 10; classtype:attempted-recon; sid:1000003; rev:1;)

# --- Exploit / initial access --------------------------------------------
alert tcp any any -> $HOME_NET 445 (msg:"ET EXPLOIT PsExec Service Install via SMB"; flow:to_server,established; content:"PSEXESVC"; nocase; classtype:trojan-activity; sid:1000010; rev:1;)
alert tcp any any -> $HOME_NET 445 (msg:"ET EXPLOIT Possible ETERNALBLUE MS17-010 Probe"; flow:to_server,established; content:"|00 00 00 00|"; offset:4; depth:4; content:"|ff|SMB"; distance:0; classtype:attempted-admin; sid:1000011; rev:1;)

# --- Lateral movement -----------------------------------------------------
alert tcp any any -> any 445 (msg:"ET POLICY SMB Session Setup from Unexpected Source"; flow:to_server,established; classtype:policy-violation; sid:1000020; rev:1;)
alert tcp any any -> any 3389 (msg:"ET POLICY RDP Session Initiated Internally"; flow:to_server,established; classtype:policy-violation; sid:1000021; rev:1;)

# --- Malware / C2 ----------------------------------------------------------
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"ET TROJAN Cobalt Strike Beacon Check-in"; flow:to_server,established; content:"|00 01 00 00 00 01 00 00 00|"; classtype:trojan-activity; sid:1000030; rev:1;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET TROJAN Possible C2 Beacon Fixed-Interval TLS"; flow:to_server; threshold:type both, track by_src, count 5, seconds 60; classtype:trojan-activity; sid:1000031; rev:1;)
alert dns $HOME_NET any -> any any (msg:"ET DNS Query for .xyz TLD Known Bad Reputation"; dns.query; content:".xyz"; nocase; endswith; classtype:bad-unknown; sid:1000032; rev:1;)

# --- Exfiltration ------------------------------------------------------
alert dns $HOME_NET any -> any any (msg:"ET DNS Exfiltration Long TXT Query"; dns.query; pcre:"/^[^.]{51,}\./"; classtype:bad-unknown; sid:1000040; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"ET POLICY Large TCP Payload to External Host"; flow:to_server,established; dsize:>1000; threshold:type threshold, track by_src, count 50000, seconds 300; classtype:policy-violation; sid:1000041; rev:1;)

# --- Policy violations (insecure protocols) -------------------------------
alert tcp any any -> $HOME_NET 23 (msg:"ET POLICY Telnet Cleartext Login Traffic"; flow:to_server,established; classtype:policy-violation; sid:1000050; rev:1;)
alert tcp any any -> $HOME_NET 21 (msg:"ET POLICY FTP Cleartext Login Traffic"; flow:to_server,established; content:"USER"; classtype:policy-violation; sid:1000051; rev:1;)
alert udp any any -> $HOME_NET 161 (msg:"ET POLICY SNMP Public Community String Access"; content:"public"; classtype:policy-violation; sid:1000052; rev:1;)
